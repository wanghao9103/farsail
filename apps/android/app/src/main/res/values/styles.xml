    <style name="ViewerBaseTheme" parent="AppTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#182327</item>
        <item name="android:navigationBarColor">#182327</item>
        <item name="android:windowBackground">#182327</item>
