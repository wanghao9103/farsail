    <style name="ViewerTheme" parent="ViewerBaseTheme" />
    <string name="control_description">仅在你开启共享并批准设备连接后，FarSail 才允许对方点击、滑动及向当前输入框输入文字。你可以随时在 App 中停止共享。开启此服务不等于允许连接。</string>
