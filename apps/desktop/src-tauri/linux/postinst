#!/bin/sh
set -eu
# The previous signed updater invokes dpkg through pkexec. Reuse that one
# authenticated installation to authorize its calling account, never all users.
if [ "${1:-}" = configure ] && [ -n "${PKEXEC_UID:-}" ] && [ "${PKEXEC_UID}" != 0 ]; then
    /usr/libexec/farsail-update-helper register
fi
